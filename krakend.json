{
  "version": 3,
  "name": "SOAP-REST Gateway",
  "port": 8081,
  "timeout": "5s",
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "plugin/http-server": {
      "name": [
        "ip-filter"
      ],
      "ip-filter": {
        "allow": true,
        "CIDR": [
          "192.168.0.0/24",
          "172.17.2.56/32",
          "10.0.0.0/16",
          "127.0.0.1"
        ]
      }
    },
    "telemetry/metrics": {
      "collection_time": "30s",
      "proxy_disabled": false,
      "router_disabled": false,
      "backend_disabled": false,
      "endpoint_disabled": false,
      "listen_address": ":8082"
    },
    "telemetry/opencensus": {
      "exporters": {
        "prometheus": {
          "port": 9091,
          "namespace": "krakend"
        }
      }
    },
    "security/cors": {
      "allow_origins": [
        "http://localhost:8081"
      ],
      "allow_methods": [
        "GET",
        "HEAD",
        "POST",
        "OPTIONS"
      ],
      "expose_headers": [
        "Content-Length",
        "Content-Type",
        "X-User-Id"
      ],
      "allow_headers": [
        "Accept-Language",
        "Authorization",
        "Content-Type"
      ],
      "max_age": "12h",
      "allow_credentials": true,
      "debug": false
    },
    "security/bot-detector": {
      "allow": [
        "Bypass/1.0"
      ],
      "deny": [],
      "patterns": [
        "(Pingdom.com_bot_version_).*",
        "(facebookexternalhit)/.*"
      ],
      "cache_size": 10000,
      "empty_user_agent_is_bot": true
    },
    "telemetry/logging": {
      "level": "DEBUG",
      "prefix": "[KRAKEND]",
      "syslog": true,
      "stdout": true
    }
  },
  "endpoints": [
    {
      "endpoint": "/css/{file}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/css/{file}",
          "method": "GET",
          "encoding": "no-op",
          "host": [
            "http://spring-boot:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/",
          "method": "GET",
          "encoding": "no-op",
          "host": [
            "http://spring-boot:8080"
          ]
        }
      ]
    },
    {
      "endpoint": "/api/users",
      "method": "GET",
      "output_encoding": "json-collection",
      "input_headers": ["Authorization", "x-rate-tier"],
      "extra_config": {
        "auth/validator": {
          "alg": "HS384",
          "jwk_local_path": "keys.json",
          "disable_jwk_security": true,
          "roles_key": "roles",
          "roles": ["admin", "user_adm"],
          "propagate_claims": [
            ["id", "id-header"],
            ["tier", "x-rate-tier"]
          ]
        },
        "qos/ratelimit/router": {
          "client_max_rate": 500,
          "client_capacity": 500,
          "every": "1h",
          "strategy": "header",
          "key": "x-rate-tier"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/users",
          "method": "GET",
          "encoding": "json",
          "is_collection": true,
          "host": [
            "http://spring-boot:8080"
          ],
          "extra_config": {
            "proxy/forward_headers": {
              "allow_all": true
            },
            "qos/circuit-breaker": {
              "interval": 60,
              "timeout": 10,
              "max_errors": 5000,
              "name": "cb-user-get-endpoint",
              "log_status_change": true
            }
          }
        }
      ]
    },
    {
      "endpoint": "/api/users/{id}",
