{
  "version": 3,
  "name": "SOAP-REST Gateway",
  "port": 8081,
  "timeout": "5s",
  "extra_config": {

    "telemetry/metrics": {
      "collection_time": "30s",
      "proxy_disabled": false,
      "router_disabled": false,
      "backend_disabled": false,
      "endpoint_disabled": false,
      "listen_address": ":8082"
    },

    "security/cors": {
      "allow_origins": [
        "*"
      ],
      "allow_methods": [
        "GET",
        "HEAD",
        "POST"
      ],
      "expose_headers": [
        "Content-Length",
        "Content-Type"
      ],
      "allow_headers": [
        "Accept-Language"
      ],
      "max_age": "12h",
      "allow_credentials": false,
      "debug": false
    },
    "security/bot-detector": {
      "allow": [
        "Bypass/1.0"
      ],
      "deny": [],
      "patterns": [
        "(Pingdom.com_bot_version_).*",
        "(facebookexternalhit)/.*"
      ],
      "cache_size": 10000,
      "empty_user_agent_is_bot": true
    },
    "telemetry/logging": {
      "level": "DEBUG",
      "prefix": "[KRAKEND]",
      "syslog": true,
      "stdout": true
    }
  },
  "endpoints": [
    {
      "endpoint": "/global/{service}/{operation}/{param}",
      "@comment": "GLOBAL endpoint. Hem sayı hem country için",
      "output_encoding": "xml",
      "method": "GET",
      "input_headers": [
        "id-header"
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 10000,
          "every": "10m",
          "client_max_rate": 2500,
          "strategy": "ip"
        },
        "auth/validator": {
          "alg": "HS384",
          "jwk_local_path": "keys.json",
          "disable_jwk_security": true,
          "roles_key": "roles",
          "roles": [
            "admin"
          ],
          "propagate_claims": [
            [
              "id",
              "id-header"
            ]
          ]
        },
        "modifier/lua-proxy": {
          "pre": "local r = request.load(); local userId = r:headers('id-header'); print('user=' .. tostring(userId) .. ' endpoint=/global/{service}/{operation}/{param}');"
        }
      },
      "backend": [
        {
          "url_pattern": "/universal/{service}/{operation}/{param}",
          "method": "GET",
          "encoding": "xml",
          "host": [
            "http://host.docker.internal:8080"
          ],
          "extra_config": {
            "qos/http-cache": {
              "shared": true
            }
          }
        }
      ]
    },
