    {
      "endpoint": "/global/{service}/{operation}/{param}",
      "output_encoding": "xml",
      "method": "GET",
      "input_headers": ["Authorization", "id-header", "x-rate-tier"],
      "input_query_strings": ["fields"],
      "extra_config": {
        "qos/ratelimit/router": {
          "client_max_rate": 5000,
          "client_capacity": 5000,
          "every": "10m",
          "strategy": "header",
          "key": "x-rate-tier"
        },
        "auth/validator": {
          "alg": "HS384",
          "jwk_local_path": "keys.json",
          "disable_jwk_security": true,
          "roles_key": "roles",
          "roles": ["admin"],
          "propagate_claims": [
            ["id", "id-header"],
            ["tier", "x-rate-tier"]
          ]
        },
        "modifier/lua-proxy": {
          "allow_open_libs": true,
          "pre": "local r = request.load(); local userId = r:headers('id-header'); print('user=' .. tostring(userId) .. ' endpoint=/single/country/{code}');",
          "post": "filterFields(request.load(), response.load())",
          "sources": [
            "./lua/field_filter.lua"
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/universal/{service}/{operation}/{param}",
          "method": "GET",
          "encoding": "xml",
          "host": [
            "http://spring-boot:8080"
          ],
          "extra_config": {
            "proxy": {
              "flatmap_filter": [
                {
                  "type": "del",
                  "args": [
                    "TCountryInfo.scurrencyISOCode"
                  ]
                }
              ]
            },
            "qos/http-cache": {
              "shared": true
            },
            "proxy/forward_headers": {
              "allow_all": true
            },
            "qos/circuit-breaker": {
              "interval": 60,
              "timeout": 10,
              "max_errors": 5000,
              "name": "cb-universal-solo-endpoint",
              "log_status_change": true
            }
          }
        }
      ]
    },
